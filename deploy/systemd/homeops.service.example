[Unit]
Description=HomeOps Telegram Bot
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple

# Create a dedicated service account for production use.
User=homeops
Group=homeops

# Generic installation path used for documentation.
WorkingDirectory=/opt/homeops
ExecStart=/opt/homeops/.venv/bin/python -m app.telegram

Restart=on-failure
RestartSec=5

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
